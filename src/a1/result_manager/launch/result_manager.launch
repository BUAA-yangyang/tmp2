<launch>
  <arg name="result_file" default="/workspace/SimEnv/results/detected_danger.json"/>

  <node pkg="a1_result_manager"
        type="result_manager_node.py"
        name="result_manager"
        output="screen">
    <rosparam command="load" file="$(find a1_result_manager)/config/result_manager.yaml"/>
    <param name="result_file" value="$(arg result_file)"/>
  </node>
</launch>
