<launch>
  <node pkg="a1_localization" type="localization_map_manager" name="localization_map_manager_test" output="screen">
    <param name="input_map_topic" value="/test/localization/map"/>
    <param name="status_topic" value="/test/localization/status"/>
    <param name="save_service" value="/test/localization/save_map"/>
    <param name="expected_frame" value="world"/>
    <param name="alignment_mode" value="fixed_start"/>
    <rosparam param="configured_world_start_translation">[0.0, -3.2, 0.6]</rosparam>
    <rosparam param="configured_world_start_rotation_xyzw">[0.0, 0.0, 0.7071081, 0.7071055]</rosparam>
    <param name="output_root" value="/tmp/a1_localization_map_manager_test"/>
    <param name="minimum_points" value="3"/>
    <param name="map_timeout" value="30.0"/>
  </node>
  <test test-name="localization_map_manager_runtime" pkg="a1_localization"
        type="localization_map_manager_runtime_test.py" time-limit="45"/>
</launch>
