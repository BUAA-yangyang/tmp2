<launch>
  <!-- ============================================================
       a1_cmd_mux：所有上层速度命令到 A1 底层的唯一出口

         /cmd_vel_emergency (100)  ─┐
         /cmd_vel_teleop     (90)  ─┤
         /cmd_vel_behavior   (50)  ─┼─> twist_mux ─> /cmd_vel_muxed
         /cmd_vel_nav        (10)  ─┘   固定优先级 + 各源超时降级
                                              │
                                              v
                                        cmd_vel_guard
                                   限速 / 限加速度 / 超时归零 / 就绪门控
                                              │
                                              v
                                          /cmd_vel   ← 唯一出口

       按 MODULES.md：任何其他模块都不得直接发布 /cmd_vel。
       ============================================================ -->

  <arg name="output_topic" default="/cmd_vel"/>
  <!-- twist_mux 的仲裁结果，中间话题，正常不用改 -->
  <arg name="muxed_topic" default="/cmd_vel_muxed"/>
  <arg name="emergency_topic" default="/cmd_vel_emergency"/>
  <arg name="emergency_timeout" default="0.5"/>
  <arg name="safety_lock_topic" default="/a1_cmd_mux/safety_lock"/>
  <arg name="status_topic" default="/a1/cmd_mux/status"/>

  <!-- 当前 unitree_guide 没有 FSM ready 话题，所以系统联调默认 false。
       验收测试会设为 true，未来由 bringup 接入真实控制器状态。 -->
  <arg name="require_ready" default="false"/>
  <arg name="ready_topic" default="/a1/controller_ready"/>
  <arg name="ready_timeout" default="1.0"/>
  <!-- 单个节点异常退出时由 roslaunch 拉起；整个 launch 正常退出时，
       guard 的 shutdown hook 会先连续发布零速度。 -->
  <arg name="respawn" default="true"/>

  <node pkg="twist_mux" type="twist_mux" name="twist_mux" output="screen"
        respawn="$(arg respawn)" respawn_delay="0.2">
    <remap from="cmd_vel_out" to="$(arg muxed_topic)"/>
    <rosparam file="$(find a1_cmd_mux)/config/twist_mux.yaml" command="load"/>
  </node>

  <node pkg="a1_cmd_mux" type="cmd_vel_guard.py" name="cmd_vel_guard" output="screen"
        respawn="$(arg respawn)" respawn_delay="0.2">
    <rosparam file="$(find a1_cmd_mux)/config/guard.yaml" command="load"/>
    <param name="input_topic"  value="$(arg muxed_topic)"/>
    <param name="output_topic" value="$(arg output_topic)"/>
    <param name="emergency_topic" value="$(arg emergency_topic)"/>
    <param name="emergency_timeout" value="$(arg emergency_timeout)"/>
    <param name="safety_lock_topic" value="$(arg safety_lock_topic)"/>
    <param name="status_topic" value="$(arg status_topic)"/>
    <param name="require_ready" value="$(arg require_ready)"/>
    <param name="ready_topic" value="$(arg ready_topic)"/>
    <param name="ready_timeout" value="$(arg ready_timeout)"/>
  </node>
</launch>
