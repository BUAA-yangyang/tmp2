# Request a mission_manager mode change from bringup, UI, or tests.
# Use std_srvs/Trigger for simple one-shot operations such as "save results".

uint8 MODE_AUTO=0
uint8 MODE_PAUSE=1
uint8 MODE_RESUME=2
uint8 MODE_STOP=3
uint8 MODE_FINISH=4

uint8 mode
string reason
---
bool accepted
string message
