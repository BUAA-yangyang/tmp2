<launch>
  <!-- Must match config/danger_perception.yaml: the <param> below OVERRIDES
       the value <rosparam> loads from that file, so a change made only in the
       yaml is silently discarded. mf64 proved it - the yaml said odom and the
       node still logged target_frame=map, dropping every detection.
        is not published by anything in this workspace; see the yaml for
       why odom rather than world. -->
  <arg name="target_frame" default="odom"/>
  <arg name="enable_tf" default="true"/>
  <arg name="publish_debug_images" default="true"/>

  <node pkg="a1_danger_perception"
        type="danger_perception_node.py"
        name="danger_perception"
        output="screen">
    <rosparam command="load" file="$(find a1_danger_perception)/config/danger_perception.yaml"/>
    <param name="target_frame" value="$(arg target_frame)"/>
    <param name="enable_tf" value="$(arg enable_tf)"/>
    <param name="publish_debug_images" value="$(arg publish_debug_images)"/>
  </node>
</launch>
