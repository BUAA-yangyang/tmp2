<launch>
  <node pkg="a1_floor_mapping" type="floor_mapping_node" name="floor_mapping_test" output="screen" required="true">
    <rosparam command="load" file="$(find a1_floor_mapping)/config/floor_mapping.yaml"/>
    <param name="topics/pointcloud" value="/test/mapping/cloud"/><param name="topics/odom" value="/test/mapping/odom"/>
    <param name="topics/localization_status" value="/test/mapping/localization"/><param name="topics/supervisor_status" value="/test/mapping/supervisor"/>
    <param name="topics/obstacle_cloud" value="/test/mapping/output_cloud"/><param name="topics/clearing_cloud" value="/test/mapping/clearing_cloud"/><param name="topics/occupancy_grid" value="/test/mapping/map"/>
    <param name="topics/status" value="/test/mapping/status"/><param name="topics/diagnostics" value="/test/mapping/diagnostics"/>
    <param name="ground/initialization_frames" value="3"/><param name="ground/minimum_candidates" value="20"/>
    <param name="ground/floor_change_frames" value="3"/><param name="recovery/valid_frames" value="2"/>
    <param name="timeouts/input_degraded" value="1.0"/><param name="timeouts/input_lost" value="2.5"/>
    <param name="timeouts/tf_queue_ros" value="5.0"/><param name="timeouts/tf_queue_wall" value="0.35"/>
    <param name="grid/width" value="10.0"/><param name="grid/height" value="10.0"/>
    <param name="grid/origin_x" value="-5.0"/><param name="grid/origin_y" value="-5.0"/>
  </node>
  <test pkg="a1_floor_mapping" type="floor_mapping_runtime_test.py" test-name="floor_mapping_runtime" time-limit="35"/>
</launch>
